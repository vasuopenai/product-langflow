# Copy to target.env (git-ignored) and fill in. Read by lightsail.sh on your PC.
LIGHTSAIL_HOST=203.0.113.10                                     # the instance's static IP
LIGHTSAIL_KEY=~/.ssh/LightsailDefaultKey-us-east-1.pem          # SSH key downloaded from Lightsail
API_DOMAIN=api.example.com                                      # DNS A record -> LIGHTSAIL_HOST
