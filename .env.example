# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/off
OPENAI_API_KEY=sk-...
# Optional
OFF_CHAT_MODEL=gpt-4o
OFF_EMBED_MODEL=text-embedding-3-small
# OFF_EMBEDDER=fake   # offline hashed embeddings, for smoke tests only

# Kroger Developer API (https://developer.kroger.com -> register an app with the Products scope)
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
